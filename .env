# ============================================================
# Traveling-v2 项目环境变量配置模板
# 复制此文件为 .env 并填入你的真实Key
# 注意: .env 文件应放在项目根目录 (Traveling-v2/)
# ============================================================

# ---- DeepSeek LLM 配置 (主控Agent + 评估脚本) ----
# 主控Agent使用: DEEPSEEK_API_KEY
# 评估脚本使用: DEEPSEEK_API 或 DEEPSEEK_API_KEY (两者都支持)
DEEPSEEK_API_KEY=sk-**********
DEEPSEEK_API=sk-**********  # 评估脚本兼容性 (可与上面相同)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 高德地图 配置 (主控Agent) ----
# 申请地址: https://console.amap.com/dev/key/app
# 需要开通 "Web服务" 类型的Key
AMAP_API_KEY=************

# ---- 搜索API配置 (评估脚本的事实验证功能) ----
# TripTailor 和 TravelPlanner 的评估脚本使用
# 用于验证生成计划中的事实信息
# 支持 SerpAPI、DuckDuckGo 等搜索引擎
SEARCH_API=mk-*********
SEARCH_API_KEY=mk-*********  # 兼容性别名 (可与上面相同)

# ---- 可选: 其他模块需要的Key ----
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

